    {
      "name": "mindmap.generate",
      "version": "2.0",
      "kind": "job",
      "title": "生成思维导图",
      "one_line": "把一句中药学主题或问题，长成一张可编辑、标了依据来源的导图",
      "use_when": [
        "要一张图看全某个主题：如「画一张麻黄的知识导图」",
        "要看清一类药的构成：如「解表药的分类」",
        "要摆开两味药的差异：如「麻黄和桂枝有什么区别」",
        "要从功效倒查药：如「哪些药能安神」",
        "要梳理硬性配伍禁忌：如「十八反有哪些」"
      ],
      "avoid_when": [
        "只问一句话的答案：如「麻黄性味是什么」——直接答比出图快",
        "问教材里没有的方药：如「紫河车有什么功效」——会整棵树退化成推断，不如直说查不到",
        "要改已有导图的结构或配色：用 mindmap.present，不要重新生成"
      ],
      "audiences": [
        "agent",
        "frontend",
        "human"
      ],
      "input_schema": {
        "properties": {
          "client_invocation_id": {
            "default": "",
            "description": "幂等键；重试时原样带回，同样的键只受理一次",
            "maxLength": 120,
            "title": "Client Invocation Id",
            "type": "string"
          },
          "context": {
            "additionalProperties": true,
            "description": "调用上下文（会话号、轮次等），只用于排查",
            "title": "Context",
            "type": "object"
          },
          "query": {
            "default": "",
            "description": "要画什么。可以是单味药、分类、对比、关系或一句自然语言提问",
            "maxLength": 200,
            "title": "Query",
            "type": "string"
          },
          "node_id": {
            "default": "",
            "description": "挂到哪个知识节点下；留空则落到自由主题节点",
            "maxLength": 64,
            "title": "Node Id",
            "type": "string"
          },
          "depth": {
            "default": 3,
            "description": "层数，2~5（句子里写了「四层」会覆盖此值）",
            "maximum": 5,
            "minimum": 2,
            "title": "Depth",
            "type": "integer"
          },
          "branches": {
            "default": 6,
            "description": "一级分支上限，3~8",
            "maximum": 8,
            "minimum": 3,
            "title": "Branches",
            "type": "integer"
          },
          "style": {
            "default": "understand",
            "description": "写法取向：应试 / 理解 / 对比",
            "enum": [
              "exam",
              "understand",
              "compare"
            ],
            "title": "Style",
            "type": "string"
          },
          "focus": {
            "default": "",
            "description": "想重点看的部分，可留空",
            "maxLength": 60,
            "title": "Focus",
            "type": "string"
          },
          "structure": {
            "default": "auto",
            "description": "logic-right / mind-both / org-down / fishbone；auto = 按问法建议",
            "title": "Structure",
            "type": "string"
          },
          "theme": {
            "default": "",
            "description": "indigo / verdant / violet / inkCream；留空用默认",
            "title": "Theme",
            "type": "string"
          }
        },
        "title": "MindmapGenerateInput",
        "type": "object"
      },
      "output_shape": {
        "ok": "bool",
        "capability": "str，固定 mindmap.generate",
        "capability_version": "str，如 2.0",
        "invocation_id": "str，受理号；重放时不变",
        "status": "accepted",
        "replayed": "bool，true 表示这次是重放，task_id 与上次相同",
        "task_id": "str，配合 stream_url 订阅进度",
        "stream_url": "str，GET 后得到 SSE：step_start / node / mindmap_verify / done",
        "artifact": "见 artifact 段；resource_id 与 open_url 在 done 之后才有值"
      },
      "pipeline": [
        {
          "id": "resolve",
          "label": "辨明主题"
        },
        {
          "id": "gather",
          "label": "采撷素材"
        },
        {
          "id": "plan",
          "label": "谋篇立骨"
        },
        {
          "id": "compose",
          "label": "敷演枝叶"
        },
        {
          "id": "normalize",
          "label": "收束形制"
        },
        {
          "id": "check",
          "label": "校验枝据"
        },
        {
          "id": "render",
          "label": "落墨成像"
        },
        {
          "id": "persist",
          "label": "封存入库"
        },
        {
          "id": "handoff",
          "label": "开卷可改"
        }
      ],
      "events": [
        "step_start",
        "step_done",
        "node",
        "mindmap_verify",
        "done",
        "error"
      ],
      "idempotency": true,
      "errors": [
        {
          "code": "mindmap.topic_empty",
          "http_status": 422,
          "message": "没有说要画什么"
        },
        {
          "code": "capability.invalid_input",
          "http_status": 422,
          "message": "参数越界"
        },
        {
          "code": "capability.not_found",
          "http_status": 404,
          "message": "知识节点不存在"
        },
        {
          "code": "mindmap.structure_unknown",
          "http_status": 422,
          "message": "不认识这种结构"
        },
        {
          "code": "mindmap.theme_unknown",
          "http_status": 422,
          "message": "不认识这套配色"
        },
        {
          "code": "capability.idempotency_mismatch",
          "http_status": 409,
          "message": "同一请求号配了不同参数"
        }
      ],
      "side_effects": [
        "新建一条炼制任务",
        "完成后在用户资源库落一张导图"
      ],
      "requires": [
        "登录用户",
        "本地中药学知识库"
      ],
      "cost": "无模型 key 时零调用；有 key 时一次结构化生成",
      "latency": "通常 6~20 秒；无 key 时 2 秒内",
      "examples": [
